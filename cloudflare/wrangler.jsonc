{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "msfactory",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "MSFactoryContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../Dockerfile",
          "build_context": ".."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MSFACTORY_CONTAINER",
        "class_name": "MSFactoryContainer"
      }
    ]
  },
  "exports": {
    "MSFactoryContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
